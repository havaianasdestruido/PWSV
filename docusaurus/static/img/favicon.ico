<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="pwsvGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00D2FF" />
      <stop offset="100%" stop-color="#3A7BD5" />
    </linearGradient>
    <linearGradient id="pwsvGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00FFA3" />
      <stop offset="100%" stop-color="#00D2FF" />
    </linearGradient>
  </defs>
  <rect width="90" height="90" x="5" y="5" rx="20" fill="#16213E" stroke="url(#pwsvGrad)" stroke-width="3"/>
  <circle cx="50" cy="50" r="8" fill="url(#pwsvGlow)"/>
  <!-- Broadcast waves -->
  <path d="M 36 36 A 20 20 0 0 0 36 64" fill="none" stroke="#00D2FF" stroke-width="3" stroke-linecap="round"/>
  <path d="M 64 36 A 20 20 0 0 1 64 64" fill="none" stroke="#00D2FF" stroke-width="3" stroke-linecap="round"/>
  <path d="M 26 26 A 34 34 0 0 0 26 74" fill="none" stroke="#00FFA3" stroke-width="2.5" stroke-linecap="round" opacity="0.8"/>
  <path d="M 74 26 A 34 34 0 0 1 74 74" fill="none" stroke="#00FFA3" stroke-width="2.5" stroke-linecap="round" opacity="0.8"/>
  <!-- Audio wave indicator bottom -->
  <line x1="30" y1="80" x2="30" y2="76" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
  <line x1="38" y1="80" x2="38" y2="72" stroke="#00FFA3" stroke-width="2" stroke-linecap="round"/>
  <line x1="46" y1="80" x2="46" y2="68" stroke="#00FFA3" stroke-width="2" stroke-linecap="round"/>
  <line x1="54" y1="80" x2="54" y2="70" stroke="#00FFA3" stroke-width="2" stroke-linecap="round"/>
  <line x1="62" y1="80" x2="62" y2="74" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
  <line x1="70" y1="80" x2="70" y2="78" stroke="#00D2FF" stroke-width="2" stroke-linecap="round"/>
</svg>
